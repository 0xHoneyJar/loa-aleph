{
  "scope": "NORMAL_WINDOWS_UAC_READ_ONLY_POST_BOOT_GATE",
  "started_at_utc": "2026-09-16T15:59:14.470407+00:00",
  "inner_script": "\n$ProgressPreference='SilentlyContinue'\n$ErrorActionPreference='Stop'\n$r=[ordered]@{scope='READ_ONLY_POST_RESTART_HYPERV_GATE';started_at_utc=[DateTime]::UtcNow.ToString('o')}\n$r.administrator=([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltinRole]::Administrator)\ntry {\n$os=Get-CimInstance Win32_OperatingSystem\n$cs=Get-CimInstance Win32_ComputerSystem\n$r.boot=[ordered]@{LastBootUpTimeUtc=$os.LastBootUpTime.ToUniversalTime().ToString('o');Caption=$os.Caption;Version=$os.Version;BuildNumber=$os.BuildNumber;OSArchitecture=$os.OSArchitecture;HypervisorPresent=$cs.HypervisorPresent}\n$r.features=@(Get-WindowsOptionalFeature -Online | Where-Object {$_.FeatureName -like 'Microsoft-Hyper-V*' -or $_.FeatureName -in @('VirtualMachinePlatform','Microsoft-Windows-Subsystem-Linux','HypervisorPlatform')} | Select-Object FeatureName,@{N='State';E={$_.State.ToString()}})\n$r.services=@(Get-CimInstance Win32_Service -Filter \"Name='vmms' OR Name='vmcompute'\" | Select-Object Name,State,StartMode,StartName,PathName)\n$r.module=@(Get-Module -ListAvailable Hyper-V | Select-Object Name,@{N='Version';E={$_.Version.ToString()}},Path)\n$r.commands=@(foreach($n in @('Get-VM','New-VM','Get-VHD','Get-VMHost','Get-VMSwitch')) {Get-Command $n | Select-Object Name,Source,@{N='Version';E={$_.Version.ToString()}}})\n$r.host=Get-VMHost | Select-Object Name,LogicalProcessorCount,MemoryCapacity,VirtualHardDiskPath,VirtualMachinePath,EnableEnhancedSessionMode,VirtualMachineMigrationEnabled,MaximumVirtualMachineMigrations,MaximumStorageMigrations,MacAddressMinimum,MacAddressMaximum,NumaSpanningEnabled\n$r.vms=@(Get-VM | Select-Object Id,Name,State,Generation,Path,ConfigurationLocation,SnapshotFileLocation,SmartPagingFilePath,Version)\n$r.switches=@(Get-VMSwitch | Select-Object Id,Name,SwitchType,NetAdapterInterfaceDescription,AllowManagementOS,DefaultFlowMinimumBandwidthWeight)\n$r.vhds=@(); foreach($vm in @(Get-VM)) { foreach($disk in @(Get-VMHardDiskDrive -VM $vm)){ if($disk.Path){$r.vhds+=@(Get-VHD -Path $disk.Path | Select-Object Path,VhdFormat,VhdType,FileSize,Size,DiskIdentifier,ParentPath,Attached)}}}\n$r.get_vhd_note='Cmdlet resolved; existing VM disk paths inspected only if present. No VHD created by this read-only gate.'\n$r.new_vm_note='Cmdlet resolved only; New-VM not invoked before authority commit and gate acceptance.'\n$r.virtualization_namespace=@(Get-CimInstance -Namespace root/virtualization/v2 -ClassName Msvm_ComputerSystem | Select-Object Name,ElementName,Caption,EnabledState)\n$r.host_disks=@(Get-CimInstance Win32_LogicalDisk -Filter 'DriveType=3' | Select-Object DeviceID,FileSystem,Size,FreeSpace)\n$r.net_adapters=@(Get-NetAdapter -IncludeHidden | Select-Object Name,InterfaceGuid,InterfaceDescription,Status,ifIndex)\n$r.status='READ_ONLY_GATE_COMPLETE'\n} catch {$r.status='READ_ONLY_GATE_FAILED';$r.error=$_.Exception.Message;$r.error_id=$_.FullyQualifiedErrorId}\n$r.finished_at_utc=[DateTime]::UtcNow.ToString('o')\n$r | ConvertTo-Json -Depth 12 | Set-Content -LiteralPath '\\\\wsl.localhost\\Ubuntu\\tmp\\src001-postrestart-continuation-20260916\\windows-elevated-result.json' -Encoding UTF8\n",
  "outer_script": "$ErrorActionPreference='Stop';try {$p=Start-Process -FilePath 'C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe' -Verb RunAs -ArgumentList @('-NoLogo','-NoProfile','-NonInteractive','-EncodedCommand','') -PassThru;[ordered]@{launched=$true;process_id=$p.Id;utc=[DateTime]::UtcNow.ToString('o')}|ConvertTo-Json -Compress}catch{[ordered]@{launched=$false;error=$_.Exception.Message;utc=[DateTime]::UtcNow.ToString('o')}|ConvertTo-Json -Compress;exit 1}",
